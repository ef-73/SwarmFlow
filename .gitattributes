# Force LF everywhere: files are used inside Linux containers (see CONTRIBUTING.md).
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.pgm binary
*.stl binary
*.dae binary
*.mcap binary
*.db3 binary
