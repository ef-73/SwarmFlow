{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swarmflow.invalid/schema/layout.schema.json",
  "title": "SwarmFlow layout definition (layouts/<name>/layout.yaml)",
  "description": "Source of truth for one warehouse layout (design §6.1). Frozen contract (M2). Units: metres, radians, map frame (x east, y north, origin at the south-west inner wall corner).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "resolution_m", "bounds", "racks", "stations", "intersections", "holds", "lanes", "zones", "spawn"],
  "properties": {
    "schema_version": {"enum": [1, 2], "description": "2 = v2 layouts (station types pick/dock/queue/home/pallet, aisles; contract-v2, decision 002)."},
    "name": {"$ref": "#/$defs/ident", "description": "Layout name; equals the directory name under layouts/."},
    "description": {"type": "string"},
    "resolution_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.2, "description": "Nav2 map resolution."},
    "bounds": {
      "description": "Inner wall rectangle. Walls are generated outside it.",
      "type": "object", "additionalProperties": false,
      "required": ["x_min", "y_min", "x_max", "y_max"],
      "properties": {
        "x_min": {"type": "number"}, "y_min": {"type": "number"},
        "x_max": {"type": "number"}, "y_max": {"type": "number"},
        "wall_height_m": {"type": "number", "exclusiveMinimum": 0, "default": 2.5},
        "wall_thickness_m": {"type": "number", "exclusiveMinimum": 0, "default": 0.2}
      }
    },
    "racks": {
      "description": "Axis-aligned solid rack boxes (collision down to the floor, design §7.2).",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "x_min", "y_min", "x_max", "y_max"],
        "properties": {
          "name": {"$ref": "#/$defs/ident"},
          "x_min": {"type": "number"}, "y_min": {"type": "number"},
          "x_max": {"type": "number"}, "y_max": {"type": "number"},
          "height_m": {"type": "number", "exclusiveMinimum": 0, "default": 2.0}
        }
      }
    },
    "stations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "type", "pose"],
        "allOf": [
          {"if": {"properties": {"type": {"const": "loading"}}, "required": ["type"]}, "then": {"properties": {"name": {"pattern": "^L[1-9][0-9]*$"}}, "not": {"anyOf": [{"required": ["queue_of"]}, {"required": ["queue_index"]}]}}},
          {"if": {"properties": {"type": {"const": "delivery"}}, "required": ["type"]}, "then": {"properties": {"name": {"pattern": "^D[1-9][0-9]*$"}}, "not": {"anyOf": [{"required": ["queue_of"]}, {"required": ["queue_index"]}]}}},
          {"if": {"properties": {"type": {"const": "park"}}, "required": ["type"]}, "then": {"properties": {"name": {"pattern": "^P[1-9][0-9]*$"}}, "not": {"anyOf": [{"required": ["queue_of"]}, {"required": ["queue_index"]}]}}},
          {"if": {"properties": {"type": {"const": "dock"}}, "required": ["type"]}, "then": {"properties": {"name": {"pattern": "^DK[1-9][0-9]*$"}}, "not": {"anyOf": [{"required": ["queue_of"]}, {"required": ["queue_index"]}]}}},
          {"if": {"properties": {"type": {"const": "home"}}, "required": ["type"]}, "then": {"properties": {"name": {"pattern": "^HM[1-9][0-9]*$"}}, "not": {"anyOf": [{"required": ["queue_of"]}, {"required": ["queue_index"]}]}}},
          {"if": {"properties": {"type": {"const": "queue"}}, "required": ["type"]}, "then": {"properties": {"name": {"pattern": "^Q_DK[1-9][0-9]*_[1-9][0-9]*$"}}, "required": ["queue_of", "queue_index"]}},
          {"if": {"properties": {"type": {"const": "pick"}}, "required": ["type"]}, "then": {"properties": {"name": {"pattern": "^PK_[0-9A-Za-z_]+$"}}, "not": {"anyOf": [{"required": ["queue_of"]}, {"required": ["queue_index"]}]}}},
          {"if": {"properties": {"type": {"const": "pallet"}}, "required": ["type"]}, "then": {"properties": {"name": {"pattern": "^PL_[0-9A-Za-z_]+$"}}, "not": {"anyOf": [{"required": ["queue_of"]}, {"required": ["queue_index"]}]}}}
        ],
        "properties": {
          "name": {"$ref": "#/$defs/station_name"},
          "type": {"enum": ["loading", "delivery", "park", "pick", "dock", "queue", "home", "pallet"],
                   "description": "v1: loading (L*), delivery (D*), park (P*). v2: pick (PK_*, shelf pick point), dock (DK*, truck dock drop point), queue (Q_DK*_*, waiting spot in a dock's queue lane), home (HM*, idle robots, first come first served), pallet (PL_*, pallet stand position)."},
          "pose": {"$ref": "#/$defs/pose"},
          "drop_offset_m": {"type": "number", "default": 0.0, "description": "Delivery stations: package drop pose distance ahead of the station pose along yaw."},
          "queue_of": {"type": "string", "pattern": "^DK[1-9][0-9]*$", "description": "Queue spots: the dock this spot waits for."},
          "queue_index": {"type": "integer", "minimum": 1, "description": "Queue spots: 1 = next in line."}
        }
      }
    },
    "intersections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "pose"],
        "properties": {
          "name": {"type": "string", "pattern": "^X_[0-9]+_[0-9]+$"},
          "pose": {"$ref": "#/$defs/point"}
        }
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "pose"],
        "properties": {
          "name": {"type": "string", "pattern": "^H_[0-9A-Za-z_]+$"},
          "pose": {"$ref": "#/$defs/point"}
        }
      }
    },
    "lanes": {
      "description": "Graph edges. A bidirectional lane is authored once; the generator emits both directions.",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "clear_width_m", "bidirectional"],
        "properties": {
          "from": {"$ref": "#/$defs/vertex"},
          "to": {"$ref": "#/$defs/vertex"},
          "clear_width_m": {"type": "number", "exclusiveMinimum": 0, "description": "Free width of the corridor the lane runs in (between rack faces / walls)."},
          "bidirectional": {"type": "boolean"},
          "speed_limit_mps": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "zones": {
      "description": "Conflict zones (design §6.1, §6.5). v2 layouts use an empty list by default (no traffic control); the key stays required.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "lanes", "vertices", "entries", "capacity", "polygon"],
        "properties": {
          "name": {"type": "string", "pattern": "^Z_[0-9A-Za-z_]+$"},
          "lanes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lane_ref"}},
          "vertices": {"type": "array", "items": {"$ref": "#/$defs/vertex"}},
          "entries": {
            "type": "array", "minItems": 1,
            "description": "Order matters: DIRECTION_FORWARD = from entries[0] towards entries[1].",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["entry", "hold"],
              "properties": {"entry": {"$ref": "#/$defs/vertex"}, "hold": {"type": "string", "pattern": "^H_[0-9A-Za-z_]+$"}}
            }
          },
          "capacity": {"type": "integer", "minimum": 1, "description": "Robots allowed in the zone at once (v1 layouts: 1)."},
          "polygon": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/xy"}, "description": "Zone area in the map frame, counter-clockwise."}
        }
      }
    },
    "aisles": {
      "description": "v2: keep-right traffic areas (N-09). The generator writes them to the sidecar; the costmap filter makes the left half (relative to the travel direction along axis) cost more.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "x_min", "y_min", "x_max", "y_max", "axis"],
        "properties": {
          "name": {"$ref": "#/$defs/ident"},
          "x_min": {"type": "number"}, "y_min": {"type": "number"},
          "x_max": {"type": "number"}, "y_max": {"type": "number"},
          "axis": {"enum": ["x", "y"], "description": "Travel axis of the aisle."},
          "keep": {"enum": ["right"], "default": "right"}
        }
      }
    },
    "spawn": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["robot_id", "vertex"],
        "properties": {
          "robot_id": {"type": "string", "pattern": "^robot_[1-9][0-9]*$"},
          "vertex": {"$ref": "#/$defs/vertex"},
          "yaw": {"type": "number", "default": 0.0}
        }
      }
    }
  },
  "$defs": {
    "ident": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "station_name": {"type": "string", "pattern": "^(L[1-9][0-9]*|D[1-9][0-9]*|P[1-9][0-9]*|DK[1-9][0-9]*|HM[1-9][0-9]*|Q_DK[1-9][0-9]*_[1-9][0-9]*|PK_[0-9A-Za-z_]+|PL_[0-9A-Za-z_]+)$"},
    "vertex": {"type": "string", "pattern": "^(L[1-9][0-9]*|D[1-9][0-9]*|P[1-9][0-9]*|DK[1-9][0-9]*|HM[1-9][0-9]*|Q_DK[1-9][0-9]*_[1-9][0-9]*|PK_[0-9A-Za-z_]+|PL_[0-9A-Za-z_]+|X_[0-9]+_[0-9]+|H_[0-9A-Za-z_]+)$"},
    "xy": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "point": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
    "pose": {"type": "object", "additionalProperties": false, "required": ["x", "y", "yaw"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "yaw": {"type": "number"}}},
    "lane_ref": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "#/$defs/vertex"}, "to": {"$ref": "#/$defs/vertex"}}}
  }
}
