{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swarmflow.invalid/schema/zones.schema.json",
  "title": "SwarmFlow sidecar (layouts/<name>/generated/zones.yaml)",
  "description": "SwarmFlow-only graph data keyed by nav-graph vertex names (design §5.4, §6.1). Generated by tools/layoutgen; frozen contract (M2). Edges are (from, to) vertex-name pairs, one entry per direction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "layout", "nav_graph", "vertices", "edges", "zones", "payloads"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "layout": {"type": "string"},
    "nav_graph": {"type": "string", "description": "Path of the RMF-format nav graph relative to this file, e.g. nav_graph.yaml."},
    "vertices": {
      "type": "object",
      "description": "name -> vertex data",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["x", "y", "kind"],
        "properties": {
          "x": {"type": "number"}, "y": {"type": "number"},
          "yaw": {"type": "number", "description": "Stations only: docking yaw."},
          "kind": {"enum": ["loading", "delivery", "park", "intersection", "hold", "pick", "dock", "queue", "home", "pallet"]},
          "queue_of": {"type": "string", "description": "Queue spots (v2): the dock this spot waits for."},
          "queue_index": {"type": "integer", "minimum": 1, "description": "Queue spots (v2): 1 = next in line."},
          "zone_entry_of": {"type": "array", "items": {"type": "string"}, "description": "Zones this vertex is an entry vertex of."},
          "hold_for": {"type": "array", "items": {"type": "string"}, "description": "Zones this vertex is the hold vertex of."}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "length_m", "clear_width_m", "bidirectional", "zone", "feasible"],
        "properties": {
          "from": {"type": "string"}, "to": {"type": "string"},
          "length_m": {"type": "number", "minimum": 0},
          "clear_width_m": {"type": "number", "exclusiveMinimum": 0},
          "bidirectional": {"type": "boolean", "description": "True if the authored lane is two-way (this entry is one direction of it)."},
          "zone": {"type": ["string", "null"], "description": "Conflict zone containing this edge, or null."},
          "two_way_ok": {"type": "object", "additionalProperties": {"type": "boolean"}, "description": "payload -> clear_width >= 2*padded_width + 0.30 (design §7.2)."},
          "feasible": {"type": "object", "additionalProperties": {"type": "boolean"}, "description": "payload -> clear_width >= padded_width + 0.10 (design §7.2)."},
          "speed_limit_mps": {"type": "number"}
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "capacity", "edges", "vertices", "entries", "polygon"],
        "properties": {
          "name": {"type": "string"},
          "capacity": {"type": "integer", "minimum": 1},
          "edges": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2}},
          "vertices": {"type": "array", "items": {"type": "string"}},
          "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["entry", "hold"], "properties": {"entry": {"type": "string"}, "hold": {"type": "string"}}}},
          "polygon": {"type": "array", "minItems": 3, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}}
        }
      }
    },
    "aisles": {
      "description": "v2 keep-right areas, copied from layout.yaml (layout.schema.json 'aisles'). Optional.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "x_min", "y_min", "x_max", "y_max", "axis", "keep"],
        "properties": {
          "name": {"type": "string"},
          "x_min": {"type": "number"}, "y_min": {"type": "number"},
          "x_max": {"type": "number"}, "y_max": {"type": "number"},
          "axis": {"enum": ["x", "y"]}, "keep": {"enum": ["right"]}
        }
      }
    },
    "payloads": {
      "type": "object",
      "description": "payload name ('unloaded', 'small', 'medium', 'wide', 'long'; v2 adds 'pallet', F-04) -> geometry (design §7.2).",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["size_x", "size_y", "padded_x", "padded_y", "rotation_diameter"],
        "properties": {
          "size_x": {"type": "number", "minimum": 0}, "size_y": {"type": "number", "minimum": 0},
          "padded_x": {"type": "number"}, "padded_y": {"type": "number"},
          "rotation_diameter": {"type": "number"}
        }
      }
    }
  }
}
