<?xml version="1.0"?>
<!-- SwarmFlow custom differential-drive robot (design §7.1). Args: robot_id, color, namespace.
     Frames: base_footprint (ground) → base_link (wheel axle) → lidar_link, wheels, casters.
     LiDAR: front-centre at 0.20 m, 180° FOV, outside the body hull: it sees racks, walls and the 0.05–0.30 m
     bodies of other robots, and is never occluded by its own payload (M4 decision, design §7.1). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="swarmflow_bot">
  <xacro:arg name="robot_id" default="robot_1"/>
  <xacro:arg name="namespace" default="robot_1"/>
  <xacro:arg name="color" default="0.10 0.45 0.85 1"/>
  <xacro:property name="ns" value="$(arg namespace)"/>

  <xacro:property name="body_l" value="0.60"/>
  <xacro:property name="body_w" value="0.50"/>
  <xacro:property name="body_h" value="0.25"/>
  <xacro:property name="wheel_r" value="0.075"/>
  <xacro:property name="wheel_w" value="0.04"/>
  <xacro:property name="track" value="0.42"/>
  <xacro:property name="body_z" value="${0.05 + body_h / 2 - wheel_r}"/>  <!-- body centre above base_link -->
  <xacro:property name="caster_r" value="0.025"/>
  <xacro:property name="mass" value="20.0"/>

  <material name="body"><color rgba="0.25 0.25 0.28 1"/></material>
  <material name="id_color"><color rgba="$(arg color)"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_r}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_z}"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="body"/>
    </visual>
    <!-- coloured top plate = cargo platform + ID colour -->
    <visual>
      <origin xyz="0 0 ${body_z + body_h / 2 + 0.005}"/>
      <geometry><box size="${body_l - 0.02} ${body_w - 0.02} 0.01"/></geometry>
      <material name="id_color"/>
    </visual>
    <!-- robot-number panel at the rear (visual only, flat so it never blocks a payload) -->
    <visual>
      <origin xyz="${-body_l / 2 - 0.006} 0 ${body_z}"/>
      <geometry><box size="0.01 0.30 0.15"/></geometry>
      <material name="id_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z}"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${body_z}"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (body_w**2 + body_h**2) / 12}" ixy="0" ixz="0"
               iyy="${mass * (body_l**2 + body_h**2) / 12}" iyz="0"
               izz="${mass * (body_l**2 + body_w**2) / 12}"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="black"/></visual>
      <collision><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry></collision>
      <inertial><mass value="1.0"/>
        <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0028"/></inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${track / 2}"/>
  <xacro:wheel side="right" y="${-track / 2}"/>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual><geometry><sphere radius="${caster_r}"/></geometry><material name="black"/></visual>
      <collision><geometry><sphere radius="${caster_r}"/></geometry></collision>
      <inertial><mass value="0.2"/><inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="5e-5"/></inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/><child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_r - wheel_r}"/>
    </joint>
    <gazebo reference="${name}_caster_link">
      <collision><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="front" x="0.22"/>
  <xacro:caster name="rear" x="-0.22"/>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry><material name="black"/></visual>
    <inertial><mass value="0.1"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="${body_l / 2 + 0.035} 0 ${0.20 - wheel_r}"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>${ns}/scan</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan><horizontal><samples>181</samples><resolution>1</resolution>
          <min_angle>-1.5708</min_angle><max_angle>1.5708</max_angle></horizontal></scan>
        <range><min>0.12</min><max>8.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <max_linear_acceleration>2.5</max_linear_acceleration>
      <max_angular_acceleration>3.2</max_angular_acceleration>
      <max_linear_velocity>0.6</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <topic>${ns}/cmd_vel</topic>
      <!-- wheel odometry drifts with slip (M4 finding) → kept on its own topic for comparison only -->
      <odom_topic>${ns}/wheel_odom</odom_topic>
      <tf_topic>${ns}/wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
    <!-- Gazebo ground-truth odometry (design §7.6 ground-truth localization): odom → base_footprint, no drift -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>${ns}/odom</odom_topic>
      <tf_topic>${ns}/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>${ns}/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
