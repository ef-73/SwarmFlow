<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swarmflow_gz_panel</name>
  <version>0.1.0</version>
  <description>SwarmFlow robot dashboard panel for the Gazebo GUI (gz-gui 8 plugin, T022).</description>
  <maintainer email="lead@swarmflow.invalid">SwarmFlow WS-E</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- gz-gui 8 / gz-transport 13 / gz-msgs 10 come from the vendor packages in the sim image; where they are missing
       (the dev image used by CI) the package builds nothing. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
